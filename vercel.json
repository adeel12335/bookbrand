{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ebookwriters.us" }],
      "destination": "https://www.ebookwriters.us/:path*",
      "permanent": true
    },
    {
      "source": "/ghostwriting",
      "destination": "/ebook-ghostwriting-services",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

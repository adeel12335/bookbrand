# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit secrets. On Vercel set the same keys in
# Project Settings → Environment Variables (Production + Preview).

# --- Neon (Postgres) -------------------------------------------------------
# Dashboard → your project → Connect → Connection string (pooled / -pooler host).
# Required for: /admin posts, leads storage, `npm run db:migrate`, `npm run db:seed`,
# and build-time `fetch-posts` (otherwise the site falls back to static articles).
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Resend (enquiry emails from the contact form) -------------------------
# https://resend.com/api-keys → Create API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# From address must use a domain verified in Resend (Domains → Add).
# onboarding@resend.dev works for testing but only delivers to the Resend account owner.
LEAD_NOTIFY_FROM=ebookwriters.us <hello@ebookwriters.us>
LEAD_NOTIFY_TO=info@ebookwriterusa.com

# --- Admin panel at /admin -------------------------------------------------
# First operator is seeded into Neon (admin_users) via `npm run db:seed-admin`.
ADMIN_EMAIL=admin@ebookwriters.us
ADMIN_PASSWORD=
# 24+ random characters for signed session cookies.
SESSION_SECRET=

# --- Optional: rebuild after publishing a post -----------------------------
# Vercel → Project Settings → Git → Deploy Hooks
DEPLOY_HOOK_URL=

# --- reCAPTCHA v3 (contact form) -------------------------------------------
# google.com/recaptcha/admin → create a site, type reCAPTCHA v3.
# Site key is public and needs the VITE_ prefix for the browser bundle.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score below which a submission is refused. Google suggests 0.5.
RECAPTCHA_MIN_SCORE=0.5

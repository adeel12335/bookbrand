# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit secrets. On Vercel set the same keys in
# Project Settings -> Environment Variables.

# Neon — Dashboard -> your project -> Connection string (pooled).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend. onboarding@resend.dev works for testing
# but only delivers to the address that owns the Resend account.
LEAD_NOTIFY_FROM=ebookwriters.us <hello@ebookwriters.us>
LEAD_NOTIFY_TO=info@ebookwriterusa.com

# Admin panel at /admin. Pick a long random password.
ADMIN_PASSWORD=
# 24+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Vercel -> Project Settings -> Git -> Deploy Hooks.
# Publishing an article POSTs here so the blog rebuilds and the new page is
# prerendered for crawlers. Without it you rebuild manually.
DEPLOY_HOOK_URL=

# --- reCAPTCHA v3 (contact form) ---------------------------------------
# google.com/recaptcha/admin -> create a site, type reCAPTCHA v3.
# The site key is public and must carry the VITE_ prefix to reach the browser.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score below which a submission is refused. Google suggests 0.5.
RECAPTCHA_MIN_SCORE=0.5
